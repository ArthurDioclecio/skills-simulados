{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.simulado-formatter/schema/profile.schema.json",
  "title": "Perfil de formatação",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "page",
    "document",
    "paragraph_styles",
    "character_styles",
    "rules",
    "images"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1",
        "1.0"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "page": {
      "type": "object",
      "required": [
        "size",
        "orientation",
        "margins_cm"
      ],
      "properties": {
        "size": {
          "enum": [
            "A4",
            "LETTER",
            "LEGAL",
            "CUSTOM"
          ]
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "margins_cm": {
          "type": "object",
          "required": [
            "top",
            "bottom",
            "left",
            "right"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "required": [
        "default_font",
        "default_size_pt"
      ],
      "properties": {
        "default_font": {
          "type": "string"
        },
        "default_size_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "language": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "paragraph_styles": {
      "type": "object",
      "required": [
        "body",
        "prompt",
        "alternative",
        "source",
        "image"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/paragraphStyle"
      }
    },
    "character_styles": {
      "type": "object",
      "required": [
        "normal"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/characterStyle"
      }
    },
    "rules": {
      "type": "object"
    },
    "images": {
      "type": "object"
    },
    "columns": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "paragraphStyle": {
      "type": "object",
      "properties": {
        "font": {
          "type": "string"
        },
        "size_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "alignment": {
          "enum": [
            "left",
            "center",
            "right",
            "justify"
          ]
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "left_indent_cm": {
          "type": "number"
        },
        "right_indent_cm": {
          "type": "number"
        },
        "first_line_indent_cm": {
          "type": "number"
        },
        "space_before_pt": {
          "type": "number",
          "minimum": 0
        },
        "space_after_pt": {
          "type": "number",
          "minimum": 0
        },
        "line_spacing": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "keep_together": {
          "type": "boolean"
        },
        "keep_with_next": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "characterStyle": {
      "type": "object",
      "properties": {
        "font": {
          "type": "string"
        },
        "size_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": "boolean"
        },
        "superscript": {
          "type": "boolean"
        },
        "subscript": {
          "type": "boolean"
        },
        "color": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
