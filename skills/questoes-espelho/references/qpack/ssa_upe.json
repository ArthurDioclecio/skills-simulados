{
  "schema_version": "1.0",
  "name": "SSA UPE 2026 — Arial 12, espelho exato e uma questão por página",
  "description": "Perfil editorial para o SSA/UPE: Arial 12 pt, alternativas com recuo suspenso canônico, uma questão por página e sem exposição do gabarito.",
  "page": {
    "size": "A4",
    "orientation": "portrait",
    "margins_cm": {
      "top": 1.2,
      "bottom": 1.2,
      "left": 1.7,
      "right": 1.7
    }
  },
  "document": {
    "default_font": "Arial",
    "default_size_pt": 12.0,
    "language": "pt-BR"
  },
  "paragraph_styles": {
    "body": {
      "font": "Arial",
      "size_pt": 12.0,
      "alignment": "justify",
      "line_spacing": 1.0,
      "space_before_pt": 0,
      "space_after_pt": 3,
      "keep_together": false,
      "keep_with_next": false
    },
    "mirror": {
      "font": "Arial",
      "size_pt": 10.0,
      "alignment": "left",
      "bold": true,
      "space_before_pt": 6,
      "space_after_pt": 2,
      "keep_with_next": true
    },
    "question_header": {
      "font": "Arial",
      "size_pt": 12.0,
      "alignment": "left",
      "space_before_pt": 0,
      "space_after_pt": 3,
      "keep_with_next": true
    },
    "stimulus": {
      "font": "Arial",
      "size_pt": 12.0,
      "alignment": "justify",
      "space_after_pt": 3
    },
    "prompt": {
      "font": "Arial",
      "size_pt": 12.0,
      "alignment": "justify",
      "space_before_pt": 2,
      "space_after_pt": 4,
      "keep_with_next": true
    },
    "label": {
      "font": "Arial",
      "size_pt": 12.0,
      "alignment": "left",
      "bold": true,
      "space_before_pt": 2,
      "space_after_pt": 2,
      "keep_with_next": true
    },
    "title": {
      "font": "Arial",
      "size_pt": 12.0,
      "alignment": "center",
      "bold": true,
      "space_before_pt": 2,
      "space_after_pt": 4,
      "keep_with_next": true
    },
    "quote": {
      "font": "Arial",
      "size_pt": 12.0,
      "alignment": "center",
      "italic": true,
      "left_indent_cm": 0.7,
      "right_indent_cm": 0.7,
      "space_before_pt": 2,
      "space_after_pt": 4
    },
    "caption": {
      "font": "Arial",
      "size_pt": 9.0,
      "alignment": "center",
      "space_before_pt": 0,
      "space_after_pt": 2,
      "keep_with_next": true
    },
    "source": {
      "font": "Arial",
      "size_pt": 8.5,
      "alignment": "right",
      "line_spacing": 1.0,
      "space_before_pt": 0,
      "space_after_pt": 3,
      "keep_with_next": false
    },
    "alternative": {
      "font": "Arial",
      "size_pt": 12.0,
      "alignment": "justify",
      "left_indent_cm": 0.5,
      "first_line_indent_cm": -0.5,
      "space_before_pt": 0,
      "space_after_pt": 1.5,
      "keep_together": true
    },
    "image": {
      "alignment": "center",
      "space_before_pt": 1,
      "space_after_pt": 2,
      "keep_together": true
    },
    "warning": {
      "font": "Arial",
      "size_pt": 9.0,
      "alignment": "center",
      "bold": true,
      "color": "B00020",
      "space_before_pt": 3,
      "space_after_pt": 3
    },
    "answer_key": {
      "font": "Arial",
      "size_pt": 12.0,
      "alignment": "left",
      "space_before_pt": 3,
      "space_after_pt": 2
    }
  },
  "character_styles": {
    "normal": {
      "font": "Arial",
      "size_pt": 12.0,
      "bold": false,
      "italic": false,
      "underline": false,
      "color": "000000"
    },
    "bold": {
      "bold": true
    },
    "italic": {
      "italic": true
    },
    "bold_italic": {
      "bold": true,
      "italic": true
    },
    "work_title": {
      "italic": true
    },
    "journal_title": {
      "italic": true
    },
    "article_title": {
      "italic": false
    },
    "author": {
      "italic": false
    },
    "url": {
      "italic": false,
      "underline": false,
      "color": "000000"
    },
    "correct_marker": {
      "bold": true,
      "italic": false
    },
    "superscript": {
      "superscript": true
    },
    "subscript": {
      "subscript": true
    }
  },
  "rules": {
    "show_mirror": false,
    "mirror_format": "{mirror}",
    "question_number_format": "{number}. ",
    "alternative_label_format": "{label}) ",
    "show_correct_marker": false,
    "correct_marker_text": " (Gabarito)",
    "correct_marker_role": "correct_marker",
    "show_final_answer_key": false,
    "answer_key_title": "Gabarito",
    "question_space_before_pt": 6,
    "question_space_after_pt": 0,
    "minimum_alternatives": 2,
    "maximum_alternatives": 8,
    "require_exactly_one_correct": true,
    "allow_missing_images": false,
    "divider_lines": false,
    "one_question_per_page": true
  },
  "images": {
    "default_width_percent": 62,
    "max_width_percent": 62,
    "min_recommended_width_px": 600,
    "allowed_extensions": [
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".bmp",
      ".tif",
      ".tiff"
    ],
    "preserve_aspect_ratio": true,
    "default_alt_text": "Imagem de apoio da questão."
  },
  "columns": {
    "gap_cm": 0.25,
    "cell_margin_twips": 70,
    "borders": false
  }
}
